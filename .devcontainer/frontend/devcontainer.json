{
  "name": "Frontend (React)",
  "dockerComposeFile": "../../docker-compose.yml",
  "service": "frontend",
  "workspaceFolder": "/workspace/frontend",

  // Start both services so the backend is available immediately
  "runServices": ["frontend", "backend"],
  "shutdownAction": "stopCompose",

  // Forward both ports so the frontend dev can reach the backend API in their browser
  // Vite dev server default port is 5173
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Vite Dev Server" },
    "8000": { "label": "Django API" }
  },

  // Install base dependencies then all required libraries.
  // Safe to run before the project is scaffolded (no-op if no package.json).
  "postCreateCommand": "[ -f package.json ] && npm install && npm install axios react-router-dom react-hook-form react-markdown @mui/material @emotion/react @emotion/styled || true",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "dsznajder.es7-react-js-snippets",
        "formulahendry.auto-rename-tag"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
